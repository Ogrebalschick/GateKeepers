.env
!.env.example

# Local LLM weights are not stored in Git
AI-Guard/models/*.gguf

# Local Docker data created by compose. Images and compose files stay tracked.
# `data/` matches every directory of that name. Frontend seed is source, not a volume.
volumes/
data/
!AI-Guard/frontend/src/data/
!AI-Guard/frontend/src/data/**
mariadb_data/
logs/
*.log
docker-compose.override.yml

# Local temp files, caches, and editor state
tmp/
.tmp/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.vscode/
.idea/
*.swp
